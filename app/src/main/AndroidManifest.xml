<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Phase 24 — the ONLY permission in the app.
        Required by the opt-in remote LLM planner (docs/safety.md §4). Nothing
        is ever sent unless the user explicitly configures an endpoint; by
        default the app performs no network I/O at all.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".LabApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MobileAgentLab">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MobileAgentLab"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Phase 2 — observer foundation.
            exported=false + BIND_ACCESSIBILITY_SERVICE: only Android can bind,
            and only after the user explicitly enables the service in Settings.
        -->
        <service
            android:name=".agent.data.accessibility.AgentAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

    <!-- Allowlisted demo target only (launch-intent visibility). -->
    <queries>
        <package android:name="com.noise.mobileagentlab.demo" />
    </queries>

</manifest>